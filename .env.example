# ==============================================================================
# ORBIT — Personal Work OS Environment Variables Example
# Duplicate this file to .env in your root and/or server/ directory
# ==============================================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend API Target (client/.env)
VITE_API_URL=http://localhost:5000

# Database Connection (PostgreSQL)
# Supports local PostgreSQL, Neon DB, Supabase, Render, Railway, AWS RDS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit_db

# JWT Security
# Ensure this is a minimum 32-character random string in production
JWT_SECRET=replace_with_a_long_random_secret_in_production_environment!
JWT_EXPIRES_IN=7d

# Cloudinary Integration (Image Uploads & Thumbnails)
# Required for persistent production image delivery. Obtain from Cloudinary Console.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (Nodemailer SMTP)
# Used for welcome emails and 24h deadline reminder notifications
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_or_smtp_password
EMAIL_FROM="ORBIT Work OS <noreply@orbit.app>"
