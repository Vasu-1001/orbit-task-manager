{
  "name": "orbit-personal-work-os",
  "version": "1.0.0",
  "private": true,
  "description": "ORBIT — Personal Work OS (Production Task Management SaaS)",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "verify:smtp": "npm --prefix server run verify:smtp"
  },
  "keywords": [
    "task-manager",
    "orbit",
    "saas",
    "react",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.5",
    "pg": "^8.23.1"
  }
}
