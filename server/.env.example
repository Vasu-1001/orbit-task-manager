# ==============================================================================
# ORBIT — Backend API Environment Configuration Example (server/.env)
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL: Local, Neon, Supabase, Render, AWS RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit_db

# JWT Security (Minimum 32-character random string for production)
JWT_SECRET=your_secure_jwt_secret_change_in_production!
JWT_EXPIRES_IN=7d

# Cloudinary Integration (Image Uploads & Thumbnails)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Notification Service (Transactional SMTP — Brevo / SendGrid / AWS SES)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_brevo_smtp_login
EMAIL_PASS=your_brevo_smtp_key
EMAIL_FROM="ORBIT Work OS <verified_sender@example.com>"

# Optional External Cron Security Token (e.g. cron-job.org / Vercel Cron)
CRON_SECRET=your_optional_cron_trigger_secret
